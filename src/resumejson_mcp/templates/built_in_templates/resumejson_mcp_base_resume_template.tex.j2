\BLOCK{for project in projects}
\textbf{\BLOCK{if project.url}\href{\VAR{project.url}}{\VAR{project.name | default('Project') | escape_latex}}\BLOCK{else}\VAR{project.name | default('Project') | escape_latex}\BLOCK{endif}}\BLOCK{if project.start_date or project.end_date} \textit{(\BLOCK{if project.start_date}\VAR{project.start_date}\BLOCK{endif}\BLOCK{if project.end_date} - \VAR{project.end_date}\BLOCK{else}\BLOCK{if project.start_date} - Present\BLOCK{endif}\BLOCK{endif})}\BLOCK{endif}

