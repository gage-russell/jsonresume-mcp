% Color scheme
\definecolor{primarycolor}{RGB}{0, 0, 0}
\definecolor{accentcolor}{RGB}{60, 60, 60}
\definecolor{textcolor}{RGB}{0, 0, 0}
\definecolor{sidebarcolor}{RGB}{248, 248, 248}
\definecolor{rulecolor}{RGB}{200, 200, 200}

% Hyperlink setup
\hypersetup{
    colorlinks=true,
    linkcolor=black,
    urlcolor=black,
    pdftitle={Gage Russell - Resume},
    pdfauthor={Gage Russell}
}

% Remove page numbers
\pagestyle{empty}

% Set default text color to black
\color{black}

% Custom section formatting
\titleformat{\section}
    {\color{primarycolor}\large\bfseries}
    {}{0em}{}[\color{rulecolor}\titlerule]
\titlespacing*{\section}{0pt}{6pt}{4pt}

\titleformat{\subsection}
    {\color{accentcolor}\normalsize\bfseries}
    {}{0em}{}
\titlespacing*{\subsection}{0pt}{4pt}{2pt}

% Custom commands
\newcommand{\resumeSubheading}[4]{
    \vspace{1pt}
    \begin{tabularx}{\linewidth}{X r}
        \textbf{#1} & \textit{\small #2} \\
        \textit{\small #3} & \small #4 \\
    \end{tabularx}
    \vspace{-2pt}
}

\newcommand{\skill}[1]{#1}

% List formatting
\setlist[itemize]{leftmargin=*, nosep, label={\small\textbullet}, itemsep=1pt, topsep=1pt}
\AtBeginDocument{\color{black}}

% Remove paragraph indentation
\setlength{\parindent}{0pt}

% Sidebar section - smaller to fit sidebar better
\newcommand{\sidebarsection}[1]{
    \vspace{9pt}
    {\color{primarycolor}\normalsize\bfseries\MakeUppercase{#1}}
    \par
    \vspace{1pt}
    \color{rulecolor}\rule{\linewidth}{0.5pt}
    \vspace{3pt}
}

% Job separator
\newcommand{\jobseparator}{
    \vspace{1pt}
    {\color{rulecolor}\rule{\linewidth}{0.3pt}}
    \vspace{1pt}
}

\begin{document}

% ========== HEADER ==========
\BLOCK{if basics}
\begin{center}
    {\Huge\bfseries \VAR{basics.name | default('') | escape_latex}} \\
    \BLOCK{if basics.label}
    \vspace{4pt}
    {\large \VAR{basics.label | escape_latex}} \\
    \BLOCK{endif}
    \vspace{5pt}
    {\small
    \BLOCK{if basics.email}
    \faEnvelope\ \href{mailto:\VAR{basics.email}}{\VAR{basics.email}}
    \BLOCK{endif}
    \BLOCK{if basics.phone}
    \quad \faPhone\ \VAR{basics.phone}
    \BLOCK{endif}
    \BLOCK{if basics.location and basics.location.city}
    \quad \faMapMarker*\ \VAR{basics.location.city | escape_latex}\BLOCK{if basics.location.region}, \VAR{basics.location.region | escape_latex}\BLOCK{endif}
    \BLOCK{endif}
    \\
    \vspace{2pt}
    \BLOCK{set linkedin_profile = basics.profiles | selectattr("network", "equalto", "LinkedIn") | first | default(none) }
    \BLOCK{if linkedin_profile}
    \faLinkedin\ \href{\VAR{linkedin_profile.url}}{\VAR{linkedin_profile.username | default(linkedin_profile.url) | escape_latex}}
    \BLOCK{endif}
    \BLOCK{set github_profile = basics.profiles | selectattr("network", "equalto", "GitHub") | first | default(none) }
    \BLOCK{if github_profile}
    \quad \faGithub\ \href{\VAR{github_profile.url}}{\VAR{github_profile.username | default(github_profile.url) | escape_latex}}
    \BLOCK{endif}
    }
\end{center}

\vspace{-4pt}
\BLOCK{endif}

