\BLOCK{endif}

\vspace{4pt}

% ========== EDUCATION ==========
\BLOCK{if education}
\section{Education}

\BLOCK{for edu in education}
\resumeSubheading
    {\VAR{edu.study_type | default('Degree') | escape_latex}\BLOCK{if edu.area} in \VAR{edu.area | escape_latex}\BLOCK{endif}}{\BLOCK{if edu.end_date}\VAR{edu.end_date}\BLOCK{endif}}
    {\VAR{edu.institution | default('Institution') | escape_latex}\BLOCK{if edu.url} \href{\VAR{edu.url}}{{\small\faLink}}\BLOCK{endif}}{\BLOCK{if edu.score}GPA: \VAR{edu.score}\BLOCK{endif}}

