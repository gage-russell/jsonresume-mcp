\BLOCK{endfor}
\end{itemize}
\BLOCK{endif}

\BLOCK{if not loop.last}\vspace{4pt}\BLOCK{endif}
\BLOCK{endfor}
\BLOCK{endif}

\BLOCK{if projects}
\section{Projects}

\begin{itemize}[leftmargin=6pt, itemsep=2pt]
\BLOCK{for project in projects}
    \item \BLOCK{if project.url}\faGithub\ \href{\VAR{project.url}}{\VAR{project.name | default('Project') | escape_latex}}\BLOCK{else}\VAR{project.name | default('Project') | escape_latex}\BLOCK{endif}
    \BLOCK{if project.description} \\
    {\scriptsize \VAR{project.description | escape_latex}}
    \BLOCK{endif}
\BLOCK{endfor}
\end{itemize}
